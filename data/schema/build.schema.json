{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "build.schema.json",
  "title": "Build slot assignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "class",
    "skills",
    "variants",
    "gear",
    "boards",
    "glyphs",
    "talismans",
    "rotation",
    "uptime",
    "defense",
    "weaponDmg",
    "mainStat",
    "critChance",
    "critDmg",
    "vulnPct",
    "overpowerPct"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "class": { "type": "string" },
    "skills": { "type": "array", "items": { "type": "string" } },
    "upgrades": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skillId", "name"],
        "properties": {
          "skillId": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "variants": { "type": "array", "items": { "type": "string" } },
    "gear": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": { "$ref": "#/$defs/slotAssignment" }
    },
    "boards": { "type": "array", "items": { "$ref": "#/$defs/boardStub" } },
    "glyphs": { "type": "array", "items": { "$ref": "#/$defs/glyphStub" } },
    "talismans": { "type": "array", "items": { "type": ["string", "null"] } },
    "rotation": { "type": "array", "items": { "$ref": "#/$defs/rotationStep" } },
    "uptime": { "$ref": "#/$defs/uptime" },
    "defense": { "$ref": "#/$defs/defense" },
    "weaponDmg": { "type": ["number", "null"] },
    "mainStat": { "type": ["number", "null"] },
    "critChance": { "type": ["number", "null"] },
    "critDmg": { "type": ["number", "null"] },
    "vulnPct": { "type": ["number", "null"] },
    "overpowerPct": { "type": ["number", "null"] },
    "overpowerStacks": { "$ref": "#/$defs/overpowerStacks" },
    "label": { "type": "string" },
    "source": { "type": "string", "minLength": 1 },
    "verified": { "type": "boolean" },
    "note": { "type": ["string", "null"] },
    "maxFury": { "type": ["number", "null"] },
    "resistanceCapPct": { "type": ["number", "null"] },
    "expertise": { "type": ["string", "null"] },
    "runes": { "type": "array", "items": { "type": "string" } },
    "manualInputsVerified": { "type": "boolean" },
    "sheet": { "$ref": "#/$defs/characterSheet" },
    "paragon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "pointsSpent", "source", "verified"],
      "properties": {
        "level": { "type": ["integer", "null"] },
        "pointsSpent": { "type": ["integer", "null"] },
        "source": { "type": "string", "minLength": 1 },
        "verified": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "suspectReadings": {
      "type": "array",
      "items": { "$ref": "#/$defs/suspectReading" }
    }
  },
  "$defs": {
    "slotAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slotId", "affixes", "aspectId", "uniqueId"],
      "properties": {
        "slotId": { "type": "string", "minLength": 1 },
        "affixes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["affixId", "value"],
            "properties": {
              "affixId": { "type": "string" },
              "value": { "type": ["number", "null"] }
            }
          }
        },
        "aspectId": { "type": ["string", "null"] },
        "uniqueId": { "type": ["string", "null"] },
        "itemName": { "type": ["string", "null"] },
        "hands": { "type": ["string", "null"] },
        "weaponType": { "type": ["string", "null"] },
        "attacksPerSecond": { "type": ["number", "null"] },
        "itemCritChance": { "type": ["number", "null"] },
        "itemNote": { "type": ["string", "null"] },
        "arsenalSlot": { "type": ["string", "null"] },
        "critDamageMultiplier": { "type": ["number", "null"] },
        "critDamageMultiplierBucket": {
          "enum": ["additive", "multiplicative", "crit", "vuln", "overpower", "mainstat", "special", "none", "additive?", "vuln?", null]
        },
        "verifiedFacts": { "type": "array", "items": { "type": "string" } },
        "masterworkLevel": { "type": ["integer", "null"], "minimum": 0, "maximum": 25 },
        "transfigured": { "type": ["boolean", "null"] },
        "sockets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gemId", "slotType"],
            "properties": {
              "gemId": { "type": "string", "minLength": 1 },
              "slotType": { "type": "string", "minLength": 1 },
              "value": { "type": ["number", "null"] },
              "bucket": {
                "enum": ["additive", "multiplicative", "crit", "vuln", "overpower", "mainstat", "special", "none", "additive?", "vuln?", null]
              }
            }
          }
        }
      }
    },
    "boardStub": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boardId", "nodeIds"],
      "properties": {
        "boardId": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "nodeIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "glyphStub": {
      "type": "object",
      "additionalProperties": false,
      "required": ["glyphId", "level"],
      "properties": {
        "glyphId": { "type": ["string", "null"] },
        "level": { "type": ["number", "null"] },
        "levelVerified": { "type": "boolean" },
        "levelApproximate": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" }
        }
      }
    },
    "rotationStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skillId", "castsPerSecond"],
      "properties": {
        "skillId": { "type": "string" },
        "castsPerSecond": { "type": ["number", "null"] }
      }
    },
    "overpowerStacks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["perStack", "maxStacks", "activeStacks", "lingerSeconds", "estimate"],
      "properties": {
        "perStack": { "type": "number" },
        "maxStacks": { "type": "integer" },
        "activeStacks": { "type": "integer" },
        "lingerSeconds": { "type": "number" },
        "gainPerSecond": { "type": "number" },
        "stackSeconds": { "type": "number" },
        "estimate": { "type": "boolean" },
        "source": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    },
    "uptime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["berserk", "vulnerable", "overpower"],
      "properties": {
        "berserk": { "type": ["number", "null"] },
        "vulnerable": { "type": ["number", "null"] },
        "overpower": { "type": ["number", "null"] },
        "estimate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "berserk": { "type": "boolean" },
            "vulnerable": { "type": "boolean" },
            "overpower": { "type": "boolean" },
            "note": { "type": "string" }
          }
        }
      }
    },
    "defense": {
      "type": "object",
      "additionalProperties": false,
      "required": ["life", "armor", "resists", "armorMitigationPct", "resistMitigationPct", "dr"],
      "properties": {
        "life": { "type": ["number", "null"] },
        "armor": { "type": ["number", "null"] },
        "resists": { "type": ["number", "null"] },
        "armorMitigationPct": { "type": ["number", "null"] },
        "resistMitigationPct": { "type": ["number", "null"] },
        "dr": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "items": { "type": ["number", "null"] } }
          ]
        }
      }
    },
    "characterSheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "strength", "intelligence", "willpower", "dexterity", "armor", "toughness", "toughnessScope", "weaponDamage", "maxLife", "source", "verified"],
      "properties": {
        "level": { "type": "integer" },
        "strength": { "type": "number" },
        "intelligence": { "type": "number" },
        "willpower": { "type": "number" },
        "dexterity": { "type": "number" },
        "armor": { "type": "number" },
        "toughness": { "type": "number" },
        "toughnessScope": { "type": "string" },
        "weaponDamage": { "type": "number" },
        "maxLife": { "type": "number" },
        "source": { "type": "string", "minLength": 1 },
        "verified": { "type": "boolean" },
        "note": { "type": "string" },
        "videoReadings": {
          "type": "array",
          "items": { "$ref": "#/$defs/videoReading" }
        }
      }
    },
    "suspectReading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "videoValue", "confirmedValue", "suspect", "source"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "videoValue": { "type": ["number", "string", "null"] },
        "confirmedValue": { "type": ["number", "string", "null"] },
        "suspect": { "type": "boolean" },
        "source": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    },
    "videoReading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stat", "value", "suspect", "source"],
      "properties": {
        "stat": { "type": "string", "minLength": 1 },
        "value": { "type": ["number", "null"] },
        "unit": { "type": ["string", "null"] },
        "suspect": { "type": "boolean" },
        "source": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    }
  }
}
