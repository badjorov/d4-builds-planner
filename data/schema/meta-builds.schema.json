{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meta-builds.schema.json",
  "title": "Known meta builds",
  "type": "object",
  "additionalProperties": false,
  "required": ["builds"],
  "properties": {
    "note": { "type": "string" },
    "builds": {
      "type": "array",
      "items": { "$ref": "#/$defs/metaBuild" }
    }
  },
  "$defs": {
    "metaBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "example", "skills", "aspects", "uniques", "keyItems", "bucketProfile", "source", "verified"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "example": { "type": "boolean" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "aspects": { "type": "array", "items": { "type": "string" } },
        "uniques": { "type": "array", "items": { "type": "string" } },
        "keyItems": { "type": "array", "items": { "type": "string" } },
        "bucketProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["additive", "multiplicative", "mainstat", "crit", "vuln", "overpower"],
          "properties": {
            "additive": { "type": ["number", "null"] },
            "multiplicative": { "type": ["number", "null"] },
            "mainstat": { "type": ["number", "null"] },
            "crit": { "type": ["number", "null"] },
            "vuln": { "type": ["number", "null"] },
            "overpower": { "type": ["number", "null"] }
          }
        },
        "source": { "type": "string", "minLength": 1 },
        "verified": { "type": "boolean" },
        "note": { "type": ["string", "null"] },
        "author": { "type": ["string", "null"] },
        "updated": { "type": ["string", "null"] },
        "recordedOn": { "type": ["string", "null"] },
        "expertise": { "type": ["string", "null"] },
        "gear": { "$ref": "#/$defs/gearList" },
        "paragon": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "string" }
          }
        },
        "seasonal": { "$ref": "#/$defs/seasonalList" }
      }
    },
    "gearList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["helm", "chest", "gloves", "pants", "boots", "amulet", "ring1", "ring2", "bludgeoning", "slashing", "dualWield1", "dualWield2"],
      "properties": {
        "helm": { "type": ["string", "null"] },
        "chest": { "type": ["string", "null"] },
        "gloves": { "type": ["string", "null"] },
        "pants": { "type": ["string", "null"] },
        "boots": { "type": ["string", "null"] },
        "amulet": { "type": ["string", "null"] },
        "ring1": { "type": ["string", "null"] },
        "ring2": { "type": ["string", "null"] },
        "bludgeoning": { "type": ["string", "null"] },
        "slashing": { "type": ["string", "null"] },
        "dualWield1": { "type": ["string", "null"] },
        "dualWield2": { "type": ["string", "null"] }
      }
    },
    "seasonalList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runes", "charms"],
      "properties": {
        "runes": { "type": "array", "items": { "type": "string" } },
        "charms": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
